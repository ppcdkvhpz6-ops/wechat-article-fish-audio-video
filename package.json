{
  "name": "wechat-article-remotion-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test scripts/demo_data.test.mjs",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "tts:fish": "python3 scripts/fish_tts.py --text \"这是良配 AI 的一段示例文章配音。\"",
    "still": "remotion still src/index.ts ArticleVideo renders/frame-030.png --frame=30 --scale=0.25",
    "render:preview": "remotion render src/index.ts ArticleVideo renders/preview-low.mp4 --scale=0.5 --crf=28 --concurrency=2 --overwrite",
    "render": "remotion render src/index.ts ArticleVideo renders/demo.mp4"
  },
  "dependencies": {
    "@remotion/media": "4.0.484",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.484"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.484",
    "@types/node": "24.0.10",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "typescript": "5.8.3"
  }
}
